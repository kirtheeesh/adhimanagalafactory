{
  "expo": {
    "name": "factory-management",
    "slug": "factory-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon.jpeg",
    "scheme": "myapplication",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/favicon.jpeg"
    },
    "android": {
      "package": "com.factory.management",
      "edgeToEdgeEnabled": true,
      "compileSdkVersion": 35,
      "targetSdkVersion": 35,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.jpeg",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1a1c1eef-6c66-4dea-82a3-2d4eab9cd37f"
      }
    },
    "owner": "kirtheeshh"
  }
}
